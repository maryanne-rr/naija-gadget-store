# =============================================================================
#  Copy this file to `.env.local` and fill in the blanks.
#  Next.js only reads env vars from .env.local, and it is git-ignored so your
#  secrets never get committed.
#
#  Get each one by following README.md. There is no payment key - the payment
#  page is a test gateway and needs no configuration.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SUPABASE  (database)
#    Dashboard > Project Settings > Data API
#    https://supabase.com/dashboard  ->  New project
#    Then run supabase/schema.sql in Dashboard > SQL Editor > New query
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# 2. MAILGUN  (order confirmation emails)
#    https://signup.mailgun.com  ->  verify your email -> copy the API key
#    Your sending domain is usually  sandbox.mailgun.org  until you verify a
#    real domain. Emails can only go TO that sandbox's authorised recipients.
# -----------------------------------------------------------------------------
# NOTE: these placeholders deliberately avoid looking like real keys. GitHub's
# push protection blocks pushes containing strings that match known secret
# patterns - a fake "key-0000..." is indistinguishable from a live one, and it
# will stop the repo from being pushed at all.
MAILGUN_API_KEY=paste-your-private-key-here
MAILGUN_DOMAIN=sandbox.mailgun.org
MAIL_FROM="Naija Gadget Store <no-reply@sandbox.mailgun.org>"

# -----------------------------------------------------------------------------
# 3. GOOGLE  (sign in with Google)
#    https://console.cloud.google.com  ->  new project -> enable "Google People"
#    API -> Credentials > Create Credentials > OAuth client ID > Web application
#    Authorised redirect URI:  http://localhost:3000/api/auth/callback/google
#    Authorised JS origin:     http://localhost:3000
# -----------------------------------------------------------------------------
AUTH_GOOGLE_ID=paste-your-client-id-here
AUTH_GOOGLE_SECRET=paste-your-client-secret-here

# Generate with:  npx auth secret      (or: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-string

# -----------------------------------------------------------------------------
# 3. PAYMENTS
#
#    There is nothing to configure. Checkout ends on /checkout/pay, a test
#    payment page that records the order as paid without collecting card
#    details.
#
#    To use a real gateway later, see the comments at the bottom of
#    src/lib/payment.ts - it is the only file that needs to change.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# 4. Leave these alone
# -----------------------------------------------------------------------------
AUTH_TRUST_HOST=true
